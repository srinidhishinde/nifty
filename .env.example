APP_ENV=paper

LIVE_TRADING_ENABLED=false
PAPER_TRADING=true
ALLOW_ORDER_SUBMISSION=false

CAPITAL=0
MAX_RISK_PER_TRADE=15000
MAX_DAILY_LOSS=30000
MAX_TRADES_PER_DAY=15

NEO_CONSUMER_KEY=
NEO_MOBILE=+91XXXXXXXXXX
NEO_UCC=
NEO_MPIN=

# Current Kotak Neo NIFTY historical Neo symbol; resolve from scrip master.
NEO_NIFTY_NEOSYMBOL=

# ChatGPT dashboard assistant
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# WhatsApp Cloud API alerts (disabled by default)
WHATSAPP_ALERTS_ENABLED=false
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Comma-separated E.164 recipient numbers
WHATSAPP_RECIPIENTS=
WHATSAPP_GRAPH_VERSION=v23.0
